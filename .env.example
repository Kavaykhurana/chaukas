# Copy to .env (docker compose reads it automatically). Never commit the real file.
GEMINI_API_KEY=            # from https://aistudio.google.com/apikey ; empty = rules + community intel only
GEMINI_MODEL=gemini-2.0-flash
JWT_SECRET=                # >= 32 random bytes, e.g. `openssl rand -hex 32`
DB_PASSWORD=chaukas
SEED_DEMO=true             # demo accounts + sample scam intel; false for real users
CORS_ORIGINS=http://localhost:3000
